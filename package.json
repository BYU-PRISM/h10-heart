{
  "name": "h10-heart",
  "version": "1.0.0",
  "description": "Browser-only analysis of Polar H10 single-lead ECG recordings",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node scripts/serve-local.mjs",
    "verify": "node --max-old-space-size=8192 scripts/verify-samples.mjs && node scripts/verify-respiration.mjs",
    "verify:respiration": "node scripts/verify-respiration.mjs",
    "verify:ui": "node scripts/verify-respiration-ui.mjs",
    "examples:respiration": "node --max-old-space-size=8192 scripts/analyze-respiration-examples.mjs",
    "examples:render": "node scripts/render-respiration-examples.mjs",
    "examples:build": "node --max-old-space-size=8192 tools/deidentify.mjs"
  },
  "keywords": [
    "ecg",
    "polar-h10",
    "hrv",
    "heart-rate"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "buffer": "^6.0.3",
    "fit-file-parser": "^2.3.3",
    "jszip": "^3.10.1",
    "pako": "^1.0.11",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
